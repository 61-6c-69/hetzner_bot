# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hetzner_bot
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DOMAIN=yourdomain.com

# Authentication
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Services
BOT_TOKEN=your_telegram_bot_token
HETZNER_API_KEY=your_hetzner_api_key

# URLs (constructed using above variables)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Bot Configuration
ADMIN_IDS=123456789,987654321

# SMS.ir Configuration
SMS_API_KEY=your-sms-api-key
SMS_TEMPLATE_ID=your-template-id

# Zarinpal Configuration
ZARINPAL_MERCHANT=your-merchant-id
ZARINPAL_CALLBACK_URL=https://your-domain.com/api/payments/verify

# Domain Configuration
DOMAIN=your-domain.com

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com 

SUPPORT_CHAT_ID=your_chat_id